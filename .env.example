# USIS Construction Management
USISCM_BASE_URL=https://www.usiscm.com

# Microsoft sign-in (same SSO as the website). Tenant and client are
# discovered from /auth/microsoft/start unless you set them here.
USISCM_MS_TENANT_ID=
USISCM_MS_CLIENT_ID=
# Optional one-shot token instead of `usiscm-ingest login`
USISCM_MS_ACCESS_TOKEN=
USISCM_MS_TOKEN_PATH=

# Required for unattended night jobs (same key as Autodesk Desktop Connector:
# CM_INGEST_API_KEY / CM_API_KEY on the USISCM server). No Microsoft prompt.
USISCM_INGEST_API_KEY=

# Optional defaults for unattended server runs
USISCM_WATCH_DIR=
USISCM_WORK_DIR=
USISCM_PROCESSED_DIR=
USISCM_FAILED_DIR=
USISCM_POLL_SECONDS=60
