# USIS Construction Management
USISCM_BASE_URL=https://www.usiscm.com

# Microsoft sign-in (same SSO as USISPdfApp / usiscm.com). Required to
# mint native B2 upload URLs and to log review issues on the website.
# Tenant and client are discovered from /auth/microsoft/start unless set.
USISCM_MS_TENANT_ID=
USISCM_MS_CLIENT_ID=
# Optional one-shot token instead of `usiscm-ingest login`
USISCM_MS_ACCESS_TOKEN=
USISCM_MS_TOKEN_PATH=

# Optional machine key (CM_INGEST_API_KEY / CM_API_KEY on the site).
# Used for unattended document uploads and as a fallback when Microsoft
# is unavailable. Website ingest-error review needs Microsoft.
USISCM_INGEST_API_KEY=

# Autodesk Desktop Connector download root on this server
USISCM_WATCH_DIR=C:\Users\CharlesDossett\DC\ACCDocs

# Sidecar manifests (outside ACCDocs so Desktop Connector does not sync them)
USISCM_PROCESSED_DIR=C:\Users\CharlesDossett\DC\USISCM-ingest\processed
USISCM_FAILED_DIR=C:\Users\CharlesDossett\DC\USISCM-ingest\failed
USISCM_WORK_DIR=
USISCM_POLL_SECONDS=60
USISCM_SETTLE_SECONDS=15

# Keep ACC project folders in place after import (required for Desktop Connector)
USISCM_LEAVE_IN_PLACE=true

# Ask the website sheet-identity AI when a title-block crop is available
USISCM_SHEET_AI=true
USISCM_UPLOAD_TIMEOUT=600

# Specialty takeoff queue (usis.specialty_takeoff.v1), written after a clean ingest.
# Default when unset: C:\usis-cm\data\queues\specialty_takeoff
# USIS_SPECIALTY_TAKEOFF_QUEUE=

# YAML map of specialty → command or module for `usiscm-ingest specialty-run`.
# See usiscm-specialty-runners.example.yaml. One worker; not started by watch.
# USIS_SPECIALTY_RUNNERS=

# Spec_Parser CLI (CSI section PDFs for project manuals). Not gui.py.
# Default when unset: D:\Programs\Spec_Parser
# Command: python cli.py <manual.pdf> -o <estimate>\02_Processed\spec_splits\<stem> --by section
# A missing install or a parse error keeps the whole Specs PDF as a document.
# SPEC_PARSER_DIR=D:\Programs\Spec_Parser
# USISCM_SPEC_PARSER_DIR is used only when SPEC_PARSER_DIR is unset.
# Interpreter override when the ingest venv cannot import Spec_Parser's deps:
# SPEC_PARSER_PYTHON=
